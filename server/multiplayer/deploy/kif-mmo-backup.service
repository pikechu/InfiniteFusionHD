[Unit]
Description=KIF verified SQLite snapshot and encrypted offsite backup
RequiresMountsFor=/var/lib/kif-mmo

[Service]
Type=oneshot
User=kif-mmo
Group=kif-mmo
WorkingDirectory=/opt/kif-mmo/current/server/multiplayer
Environment=KIF_CONFIG=/etc/kif-mmo/production.json
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/kif-mmo/current/venv/bin/python production_ops.py backup
TimeoutStartSec=12min
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/kif-mmo
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
