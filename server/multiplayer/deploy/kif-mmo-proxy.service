[Unit]
Description=KIF dedicated HTTPS reverse proxy
After=network-online.target kif-mmo.service
Wants=network-online.target

[Service]
User=caddy
Group=caddy
ExecStart=/opt/kif-mmo/tools/caddy run --config /etc/kif-mmo-caddy/Caddyfile --adapter caddyfile
ExecReload=/opt/kif-mmo/tools/caddy reload --address 127.0.0.1:2020 --config /etc/kif-mmo-caddy/Caddyfile --adapter caddyfile
Environment=XDG_DATA_HOME=/var/lib/kif-mmo-caddy
Environment=XDG_CONFIG_HOME=/var/lib/kif-mmo-caddy
StateDirectory=kif-mmo-caddy
Restart=on-failure
RestartSec=5
TimeoutStopSec=15
UMask=0077
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/kif-mmo-caddy

[Install]
WantedBy=multi-user.target
