# Copy to .env, replace both passwords, then start only db/matomo first.
MARIADB_PASSWORD=replace-with-a-long-random-database-password
MARIADB_ROOT_PASSWORD=replace-with-a-different-long-random-root-password
MATOMO_PORT=8081
DOWNLOAD_PORT=8082

# Compose-only internal collector. Use HTTPS for a collector on another server.
MATOMO_TRACKER_URL=http://matomo/matomo.php
MATOMO_ALLOW_INTERNAL_HTTP=1

# Fill after creating a separate Downloads site and a write-only tracking user.
MATOMO_DOWNLOAD_SITE_ID=
MATOMO_DOWNLOAD_TOKEN_AUTH=

# Exact proxy socket IPs only; empty means ignore X-Forwarded-For entirely.
TRUSTED_PROXY_IPS=
